PRINTLN "--- Size Limit Tester ---"

FUNC check(label, ok)
    IF ok THEN
        PRINTLN "PASS: " + label
    ELSE
        PRINTLN "FAIL: " + label
    ENDIF
ENDFUNC

PRINTLN "--- List repetition (limit 1,000,000) ---"
LET at_limit = [1] * 1000000
check("list of exactly 1,000,000 is allowed", LEN(at_limit) == 1000000)

TRY
    LET over = [1] * 1000001
    PRINTLN "FAIL: list of 1,000,001 was allowed"
CATCH e
    PRINTLN "PASS: list repetition over limit rejected"
    PRINTLN "Caught: " + e
ENDTRY

TRY
    LET way_over = [1] * 2000000
    PRINTLN "FAIL: list of 2,000,000 was allowed"
CATCH e
    PRINTLN "PASS: list repetition far over limit rejected"
ENDTRY

PRINTLN "--- List concatenation (limit 1,000,000) ---"
LET half = [1] * 500000
LET joined = half + half
check("concatenation to exactly 1,000,000 is allowed", LEN(joined) == 1000000)

TRY
    LET too_big = half + half + [1]
    PRINTLN "FAIL: concatenation to 1,000,001 was allowed"
CATCH e
    PRINTLN "PASS: list concatenation over limit rejected"
    PRINTLN "Caught: " + e
ENDTRY

PRINTLN "--- String repetition (limit 10,000,000) ---"
LET big_str = "a" * 10000000
check("string of exactly 10,000,000 chars is allowed", LEN(big_str) == 10000000)

TRY
    LET over_str = "a" * 10000001
    PRINTLN "FAIL: string of 10,000,001 chars was allowed"
CATCH e
    PRINTLN "PASS: string repetition over limit rejected"
    PRINTLN "Caught: " + e
ENDTRY

PRINTLN "--- String concatenation (limit 10,000,000) ---"
TRY
    LET over_cat = big_str + "b"
    PRINTLN "FAIL: string concatenation over limit was allowed"
CATCH e
    PRINTLN "PASS: string concatenation over limit rejected"
    PRINTLN "Caught: " + e
ENDTRY

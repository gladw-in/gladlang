PRINTLN("=== TESTING SUPER AND INSTANCEOF ===")

CLASS Animal
    # Constructor name now matches Class name
    FUNC Animal()
        PRINTLN("Animal Constructor")
    ENDFUNC

    FUNC speak()
        RETURN "..."
    ENDFUNC
ENDCLASS

CLASS Dog INHERITS Animal
    # Constructor name now matches Class name
    FUNC Dog()
        # Call parent constructor using SUPER()
        SUPER() 
        PRINTLN("Dog Constructor")
    ENDFUNC

    FUNC speak()
        RETURN "Woof! " + SUPER.speak()
    ENDFUNC
ENDCLASS

PRINTLN("\n[1] Testing SUPER in Constructor:")
LET d = NEW Dog()
# Expected:
# Animal Constructor
# Dog Constructor

PRINTLN("\n[2] Testing SUPER in Method:")
PRINTLN(d.speak()) 
# Expected: Woof! ...

PRINTLN("\n[3] TESTING SUPER WITH ARGUMENTS:")

CLASS Animal
    # Parent constructor takes 'name'
    FUNC Animal(name)
        THIS.name = name
        PRINTLN("Animal Constructor: Set name to " + name)
    ENDFUNC

    FUNC speak()
        RETURN "..."
    ENDFUNC
ENDCLASS

CLASS Dog INHERITS Animal
    # Child constructor takes 'name' and passes it up
    FUNC Dog(name)
        SUPER(name) # <--- Passing value to parent here
        PRINTLN("Dog Constructor: Ready")
    ENDFUNC

    FUNC speak()
        RETURN THIS.name + " says Woof!"
    ENDFUNC
ENDCLASS

d = NEW Dog("Buddy")
# Output:
# Animal Constructor: Set name to Buddy
# Dog Constructor: Ready

PRINTLN(d.speak()) 
# Output: Buddy says Woof!

PRINTLN("\n[4] Testing INSTANCEOF:")
PRINTLN("d is Dog? " + STR(d INSTANCEOF Dog))       # Expected: 1
PRINTLN("d is Animal? " + STR(d INSTANCEOF Animal)) # Expected: 1
PRINTLN("d is String? " + STR(d INSTANCEOF String)) # Expected: 0

CLASS Cat
ENDCLASS

LET c = NEW Cat()
PRINTLN("c is Animal? " + STR(c INSTANCEOF Animal)) # Expected: 0

PRINTLN("\n[5] TESTING HYBRID PARENT CALLS")

CLASS Animal
    FUNC Animal()
        PRINTLN("Animal Constructor")
    ENDFUNC

    FUNC speak()
        RETURN "Generic Sound"
    ENDFUNC
ENDCLASS

CLASS Human
    FUNC Human()
        PRINTLN("Human Constructor")
    ENDFUNC

    FUNC speak()
        RETURN "Hello"
    ENDFUNC
ENDCLASS

CLASS Dog INHERITS Animal, Human
    FUNC Dog()
        PRINTLN("--- Initializing Dog ---")
        
        # STYLE 1: Explicit Calls (Great for Multiple Inheritance)
        Animal.Animal()
        Human.Human()
        
        # STYLE 2: SUPER Call (Great for Single Inheritance / MRO)
        # This will call 'Animal' again because it's first in MRO
        PRINTLN("--- Calling SUPER() ---")
        SUPER() 
    ENDFUNC

    FUNC speak()
        # Mix both styles in methods too
        RETURN "Woof! " + SUPER.speak() + " " + Human.speak()
    ENDFUNC
ENDCLASS

d = NEW Dog()
# Expected:
# --- Initializing Dog ---
# Animal Constructor
# Human Constructor
# --- Calling SUPER() ---
# Animal Constructor

PRINTLN("\n[Speaking]")
PRINTLN(d.speak())
# Expected: Woof! Generic Sound Hello
PRINTLN "\n=== 6. SUPER + Overloaded Methods ==="

CLASS OverloadedParent
    FUNC calculate(a)
        RETURN a + 1
    ENDFUNC

    FUNC calculate(a, b)
        RETURN a + b
    ENDFUNC
ENDCLASS

CLASS OverloadedChild INHERITS OverloadedParent
    FUNC test()
        RETURN SUPER.calculate(10) + SUPER.calculate(10, 20)
    ENDFUNC
ENDCLASS

LET overloaded_child = NEW OverloadedChild()

PRINTLN "SUPER overload result: " + overloaded_child.test()
# Expected: 41


PRINTLN "\n=== 7. SUPER + Protected Visibility ==="

CLASS ProtectedParent
    PROTECTED FUNC protected_speak()
        RETURN "protected"
    ENDFUNC
ENDCLASS

CLASS ProtectedChildTest INHERITS ProtectedParent
    FUNC call_parent()
        RETURN SUPER.protected_speak()
    ENDFUNC
ENDCLASS

LET protected_test = NEW ProtectedChildTest()

PRINTLN "SUPER protected result: " + protected_test.call_parent()
# Expected: protected


PRINTLN "\n=== 8. SUPER + Private Visibility ==="

CLASS PrivateParent
    PRIVATE FUNC private_speak()
        RETURN "private"
    ENDFUNC
ENDCLASS

CLASS PrivateChildTest INHERITS PrivateParent
    FUNC call_parent()
        TRY
            RETURN SUPER.private_speak()
        CATCH error
            RETURN "blocked"
        ENDTRY
    ENDFUNC
ENDCLASS

LET private_test = NEW PrivateChildTest()

PRINTLN "SUPER private result: " + private_test.call_parent()
# Expected: blocked

PRINTLN "=============================================="
PRINTLN " NULL-GUARD REGRESSION TEST SUITE"
PRINTLN "=============================================="
PRINTLN ""

LET pass_count = 0
LET fail_count = 0

DEF pass(name)
    PRINTLN "[PASS] " + name
    pass_count = pass_count + 1
ENDDEF

DEF fail(name, reason)
    PRINTLN "[FAIL] " + name + " -> " + reason
    fail_count = fail_count + 1
ENDDEF

DEF expect_illegal(name, thunk)
    TRY
        thunk()
        fail(name, "expected 'Illegal operation' but no error was raised")
    CATCH e
        IF e == "Illegal operation" THEN
            pass(name)
        ELSE
            fail(name, "expected 'Illegal operation' but got: " + e)
        ENDIF
    ENDTRY
ENDDEF

DEF expect_error(name, thunk, expected_message)
    TRY
        thunk()
        fail(name, "expected an error but none was raised")
    CATCH e
        IF e == expected_message THEN
            pass(name)
        ELSE
            fail(name, "expected '" + expected_message + "' but got: " + e)
        ENDIF
    ENDTRY
ENDDEF

DEF expect_value(name, actual, expected)
    IF actual == expected THEN
        pass(name)
    ELSE
        fail(name, "expected " + expected + " but got " + actual)
    ENDIF
ENDDEF

PRINTLN "--- Section 1: Number arithmetic with NULL (must all be Illegal Operation) ---"

expect_illegal("1a: 5 + NULL",  DEF() RETURN 5 + NULL ENDDEF)
expect_illegal("1b: 5 - NULL",  DEF() RETURN 5 - NULL ENDDEF)
expect_illegal("1c: 5 * NULL",  DEF() RETURN 5 * NULL ENDDEF)
expect_illegal("1d: 5 / NULL",  DEF() RETURN 5 / NULL ENDDEF)
expect_illegal("1e: 5 % NULL",  DEF() RETURN 5 % NULL ENDDEF)
expect_illegal("1f: 5 // NULL", DEF() RETURN 5 // NULL ENDDEF)
expect_illegal("1g: 5 ** NULL", DEF() RETURN 5 ** NULL ENDDEF)
expect_illegal("1h: 5 & NULL",  DEF() RETURN 5 & NULL ENDDEF)
expect_illegal("1i: 5 | NULL",  DEF() RETURN 5 | NULL ENDDEF)
expect_illegal("1j: 5 ^ NULL",  DEF() RETURN 5 ^ NULL ENDDEF)
expect_illegal("1k: 5 << NULL", DEF() RETURN 5 << NULL ENDDEF)
expect_illegal("1l: 5 >> NULL", DEF() RETURN 5 >> NULL ENDDEF)

PRINTLN ""
PRINTLN "--- Section 2: List/string indexing and slicing with NULL ---"

expect_error("2a: list[NULL] get",       DEF() RETURN [1,2,3][NULL] ENDDEF, "List index must be a Number")
expect_error("2b: string[NULL] get",     DEF() RETURN "hello"[NULL] ENDDEF, "String index must be a Number")
expect_error("2c: list[NULL:] slice",    DEF() RETURN [1,2,3,4,5][NULL:] ENDDEF, "Start index must be a number")
expect_error("2d: list[:NULL] slice",    DEF() RETURN [1,2,3,4,5][:NULL] ENDDEF, "End index must be a number")

TRY
    LET l2e = [1, 2, 3]
    l2e[NULL] = 99
    fail("2e: list[NULL] = value (set)", "expected error but assignment succeeded")
CATCH e
    pass("2e: list[NULL] = value (set)")
ENDTRY

PRINTLN ""
PRINTLN "--- Section 3: List repetition with NULL ---"

expect_illegal("3a: list * NULL", DEF() RETURN [1,2,3] * NULL ENDDEF)

PRINTLN ""
PRINTLN "--- Section 4: TRUE/FALSE must still behave exactly as before (not blocked) ---"

expect_value("4a: 5 + TRUE == 6",       5 + TRUE, 6)
expect_value("4b: 5 * FALSE == 0",      5 * FALSE, 0)
expect_value("4c: 5 - TRUE == 4",       5 - TRUE, 4)
expect_value("4d: 10 / TRUE == 10.0",   10 / TRUE, 10.0)
expect_value("4e: 5 & TRUE == 1",       5 & TRUE, 1)
expect_value("4f: 5 >> TRUE == 2",      5 >> TRUE, 2)
expect_value("4g: list[TRUE] == 2",     [1,2,3][TRUE], 2)
expect_value("4h: string[TRUE] == 'e'", "hello"[TRUE], "e")

PRINTLN ""
PRINTLN "--- Section 5: String concatenation with NULL must still work (intentional coercion) ---"

expect_value("5a: 'x' + NULL == 'x0'", "x" + NULL, "x0")
expect_value("5b: 'x' + TRUE == 'x1'", "x" + TRUE, "x1")

PRINTLN ""
PRINTLN "--- Section 6: Casting builtins with NULL must still work (intentional coercion) ---"

expect_value("6a: INT(NULL) == 0",   INT(NULL), 0)
expect_value("6b: FLOAT(NULL) == 0.0", FLOAT(NULL), 0.0)
expect_value("6c: STR(NULL) == 'null'", STR(NULL), "null")
expect_value("6d: BOOL(NULL) == 0", BOOL(NULL), 0)

PRINTLN ""
PRINTLN "--- Section 7: Baseline sanity (things unrelated to the fix must still work) ---"

expect_value("7a: normal addition",        5 + 3, 8)
expect_value("7b: normal list index",      [10,20,30][1], 20)
expect_value("7c: normal string index",    "hello"[1], "e")
expect_value("7d: normal slice",           STR([1,2,3,4,5][1:3]), "[2, 3]")
expect_value("7e: normal list repetition", STR([1,2] * 3), "[1, 2, 1, 2, 1, 2]")

PRINTLN ""
PRINTLN "=============================================="
PRINTLN "Passed: " + pass_count
PRINTLN "Failed: " + fail_count
PRINTLN "=============================================="

IF fail_count > 0 THEN
    PRINTLN "RESULT: FAILURE"
ELSE
    PRINTLN "RESULT: SUCCESS"
ENDIF

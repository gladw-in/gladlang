# ============================================================
#  Fixture module for tests/test_modules.glad
#  Exports names under an alias (EXPORT ... AS alias), and one
#  plain export with no alias for comparison.
# ============================================================

EXPORT LET internal_pi = 3.14159 AS PI

EXPORT FUNC internal_add(a, b)
    RETURN a + b
ENDFUNC AS add

EXPORT CLASS InternalCalculator
    FUNC add(a, b)
        RETURN a + b
    ENDFUNC
ENDCLASS AS Calculator

EXPORT LET plain = "no alias"

PRINTLN "=== 1. Testing Global Function Overloading ==="

FUNC add(a, b)
  RETURN a + b
ENDFUNC

FUNC add(a, b, c)
  RETURN a + b + c
ENDFUNC

# Test 2 args
LET sum1 = add(10, 20)
PRINTLN "add(10, 20) = " + sum1 
# Expected: 30

# Test 3 args
LET sum2 = add(10, 20, 30)
PRINTLN "add(10, 20, 30) = " + sum2 
# Expected: 60


PRINTLN "\n=== 2. Testing Class Method Overloading ==="

CLASS Calculator
  # Single argument variant
  FUNC calc(x)
    RETURN x * 2
  ENDFUNC

  # Two argument variant
  FUNC calc(x, y)
    RETURN x * y
  ENDFUNC
  
  # Three argument variant
  FUNC calc(x, y, z)
    RETURN x + y + z
  ENDFUNC
ENDCLASS

LET c = NEW Calculator()

PRINTLN "c.calc(10) = " + c.calc(10)
# Expected: 20

PRINTLN "c.calc(10, 5) = " + c.calc(10, 5)
# Expected: 50

PRINTLN "c.calc(1, 2, 3) = " + c.calc(1, 2, 3)
# Expected: 6


PRINTLN "\n=== 3. Testing Constructor Overloading ==="

CLASS Vector
  # Default constructor
  FUNC Vector()
    THIS.x = 0
    THIS.y = 0
  ENDFUNC

  # Constructor with values
  FUNC Vector(x, y)
    THIS.x = x
    THIS.y = y
  ENDFUNC

  FUNC str()
    RETURN "[" + THIS.x + ", " + THIS.y + "]"
  ENDFUNC
ENDCLASS

LET v1 = NEW Vector()
PRINTLN "Vector() = " + v1.str()
# Expected: [0, 0]

LET v2 = NEW Vector(5, 10)
PRINTLN "Vector(5, 10) = " + v2.str()
# Expected: [5, 10]


PRINTLN "\n=== 4. Testing Error Handling (No Match) ==="

TRY
  PRINTLN add(1) # This should fail, no 1-arg variant exists
CATCH error
  PRINTLN "Caught expected error: " + error
ENDTRY
# Expected: Caught expected error: No variant of function 'add' found that accepts 1 arguments


PRINTLN "\n=== 5. Testing Copy Constructor ==="

CLASS Point
  # Standard Constructor (2 Arguments)
  FUNC Point(x, y)
    THIS.x = x
    THIS.y = y
  ENDFUNC

  # Copy Constructor (1 Argument)
  # This works because overloading is based on argument count (arity)
  FUNC Point(other)
    THIS.x = other.x
    THIS.y = other.y
  ENDFUNC

  FUNC str()
    RETURN "(" + THIS.x + ", " + THIS.y + ")"
  ENDFUNC
ENDCLASS

# Create an original point
LET p1 = NEW Point(10, 20)
PRINTLN "Original p1: " + p1.str()
# Expected: (10, 20)

# Create a copy using the 1-arg copy constructor
LET p2 = NEW Point(p1)
PRINTLN "Copied p2:   " + p2.str()
# Expected: (10, 20)

# Modify the copy to prove independence
p2.x = 999

PRINTLN "-- After modifying p2 --"
PRINTLN "Original p1: " + p1.str()
PRINTLN "Modified p2: " + p2.str()
# Expected p1: (10, 20)
# Expected p2: (999, 20)

PRINTLN "\n=== 8. Same-Arity Override with Different Visibility ==="

CLASS PrivateOverrideBase
    PRIVATE FUNC value(a)
        RETURN 500
    ENDFUNC
ENDCLASS

CLASS PublicOverrideChild INHERITS PrivateOverrideBase
    PUBLIC FUNC value(a)
        RETURN 600
    ENDFUNC
ENDCLASS

LET override_child = NEW PublicOverrideChild()

PRINTLN "Same-arity override result: " + override_child.value(1)
# Expected: 600


PRINTLN "\n=== 9. Inherited Static/Instance Overload Mismatch ==="

TRY
    CLASS StaticBase
        STATIC PUBLIC FUNC calculate(a)
            RETURN 700
        ENDFUNC
    ENDCLASS

    CLASS InstanceChild INHERITS StaticBase
        PUBLIC FUNC calculate(a, b)
            RETURN 800
        ENDFUNC
    ENDCLASS

    PRINTLN "FAIL: static/instance overload mismatch was accepted"
CATCH error
    PRINTLN "PASS: static/instance overload mismatch rejected"
ENDTRY


PRINTLN "\n=== 10. Valid Inherited Overloads ==="

CLASS ValidOverloadBase
    PUBLIC FUNC calculate(a)
        RETURN 10
    ENDFUNC
ENDCLASS

CLASS ValidOverloadChild INHERITS ValidOverloadBase
    PUBLIC FUNC calculate(a, b)
        RETURN 20
    ENDFUNC
ENDCLASS

LET valid_child = NEW ValidOverloadChild()

PRINTLN "Inherited overload: " + valid_child.calculate(1)
PRINTLN "Child overload: " + valid_child.calculate(1, 2)
# Expected:
# Inherited overload: 10
# Child overload: 20
